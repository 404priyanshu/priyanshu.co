# Draft Mode
DRAFT_MODE_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_LOCAL_ANALYTICS=false

# Raindrop
RAINDROP_TOKEN=

# On-Demand Revalidation
NEXT_REVALIDATE_SECRET=

# TypeSafe (bookmark moderation; skipped when unset)
TYPESAFE_API_KEY=

# Ask chat (/ask). CHAT_PROVIDER is "openai" (default) or "groq"; only that
# provider's key is needed. Set a monthly spend limit on whichever key you use.
CHAT_PROVIDER=
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional model override, as a model ID from the chosen provider.
# Defaults: gpt-5.4-mini (OpenAI), openai/gpt-oss-120b (Groq).
CHAT_MODEL=
# Optional reasoning effort for reasoning models; defaults to low.
CHAT_REASONING_EFFORT=

# Ask retrieval. The committed index uses a local model and needs no key.
# Set this to "openai" only when rebuilding with `bun run knowledge:embed`
# so document vectors come from text-embedding-3-small (256 dimensions).
# The chat then embeds each question with OPENAI_API_KEY. If the key is
# missing, the index is missing or stale, or the call fails, BM25 is used.
EMBEDDING_PROVIDER=
